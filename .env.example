# IndustrialScanner environment template
# Copy to .env and fill values for your local lab.

# === Logging ===
# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR (default INFO)
INDUSTRIALSCANNER_LOG_LEVEL=INFO

# === Modbus Scanner ===
# Default Modbus/TCP port (default 502)
INDUSTRIALSCANNER_MODBUS_DEFAULT_PORT=502
# Default Unit ID
INDUSTRIALSCANNER_MODBUS_DEFAULT_UNIT=1
# Socket timeout (seconds) per connection attempt
INDUSTRIALSCANNER_MODBUS_TIMEOUT=2.0
# Max hosts scanned in parallel (avoid hammering legacy PLCs)
INDUSTRIALSCANNER_MODBUS_MAX_CONCURRENCY=8

# === S7Comm Analyzer ===
INDUSTRIALSCANNER_S7_DEFAULT_PORT=102

# === DNP3 Analyzer ===
INDUSTRIALSCANNER_DNP3_DEFAULT_PORT=20000

# === Reports ===
# Output root for generated reports
INDUSTRIALSCANNER_REPORTS_DIR=reports
# Render HTML reports (true|false)
INDUSTRIALSCANNER_REPORT_HTML=true
# Render JSON reports (true|false)
INDUSTRIALSCANNER_REPORT_JSON=true

# === Security ===
# Sandbox HTML rendering (escape all user-controlled bytes)
# WARNING: never set to false in production environments.
INDUSTRIALSCANNER_SANITIZE_HTML=true
# Allowed source IPs/CIDRs for active scans (CSV). Empty = unrestricted.
INDUSTRIALSCANNER_ALLOWED_TARGETS=

# === Optional: SIEM forwarding ===
# SYSLOG_HOST=
# SYSLOG_PORT=514
# SYSLOG_PROTOCOL=udp
